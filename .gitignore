# Trained model weights: ship the production models, ignore any others
# (experimental checkpoints, fine-tunes, etc.).
*.pt
!solver/securimage_model.pt
!solver/model.pt
!solver/gst_model.pt
!solver/mca_model.pt
!solver/epfo_model.pt

# Scraped captcha images and evaluation data — NOT distributed (they target live
# third-party endpoints). Regenerate synthetic data with the renderer instead.
captcha_2/
corpus/
real_test/
gst_raw/
mca_raw/
epfo_raw/
kaveri_raw/
udyam_raw/
samples/
test*.png
*.png
# ...but the bundled fonts the renderers need are part of the source
!fonts/*.ttf

# session cookie jars written by the downloaders
.cookies
*.cookies

# scratch / logs / caches
scratchpad*
*.log
__pycache__/
*.pyc
.DS_Store
.venv/
venv/

# generated label-adjudication page (embeds captcha images)
gst_adjudicate.html
mca_adjudicate.html
epfo_raw/
selfimprove_state.json
